{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    // Relative imports carry their real '.ts'/'.tsx' extension so that tsc, Vite and
    // `node --import tsx` all resolve one spelling. Nothing is emitted from here — Vite builds —
    // so the extension never has to be rewritten.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    // The carried-forward render layer is JavaScript and stays JavaScript: 2,100 lines of working
    // Three.js, restructured rather than rewritten. It is `allowJs` so Vite and tsc agree about
    // it, and NOT `checkJs`, because type-checking somebody else's untyped render code produces a
    // thousand errors and zero bugs found. Its edge is typed instead, once, in game/stage.ts —
    // which is the only surface the rest of the app touches.
    "allowJs": true,
    "checkJs": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true
  },
  "include": ["src", "test", "tools", "vite.config.ts"]
}
